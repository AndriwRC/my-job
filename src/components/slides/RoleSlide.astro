---
import Emoji from "../Emoji.astro";
import Slide from "./Slide.astro";
---

<Slide
  id="role"
  eyebrow="02 · Cargo"
  badgeClass="badge-secondary"
  title="¿Cuál es mi cargo?"
  titleEmoji="🪪"
>
  <div class="card bg-base-200 brutal mt-6">
    <div class="card-body">
      <p class="text-xl font-bold break-words sm:text-2xl">
        <span class="relative inline-block">
          Implementation &amp; Support Engineer
          <span
            data-fx="strike"
            aria-hidden="true"
            class="absolute inset-x-0 top-1/2 h-1 -translate-y-1/2 bg-error"
          ></span>
        </span>
      </p>
      <div data-fx="pop" data-fx-stagger="0.15">
        <p class="mt-4 text-2xl font-bold sm:text-3xl">
          Desarrollador Web <Emoji symbol="🧑‍💻" />
        </p>
        <p class="opacity-80">(en términos sencillos)</p>
      </div>
    </div>
  </div>
</Slide>
