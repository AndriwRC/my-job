---
import Layout from '../layouts/Layout.astro';
import DeckNav from '../components/DeckNav.astro';
import IntroSlide from '../components/slides/IntroSlide.astro';
import RoleSlide from '../components/slides/RoleSlide.astro';
import CompanySlide from '../components/slides/CompanySlide.astro';
import DaySlide from '../components/slides/DaySlide.astro';
import TicketSlide from '../components/slides/TicketSlide.astro';
import DeploySlide from '../components/slides/DeploySlide.astro';
import TeamSlide from '../components/slides/TeamSlide.astro';
import FunnySlide from '../components/slides/FunnySlide.astro';
import StressSlide from '../components/slides/StressSlide.astro';
import PrideSlide from '../components/slides/PrideSlide.astro';
import ThanksSlide from '../components/slides/ThanksSlide.astro';
---

<Layout>
  <main id="deck" class="mx-auto w-full max-w-4xl pl-4 pr-7 sm:pl-6 sm:pr-9">
    <IntroSlide />
    <RoleSlide />
    <CompanySlide />
    <DaySlide />
    <TicketSlide />
    <DeploySlide />
    <TeamSlide />
    <FunnySlide />
    <StressSlide />
    <PrideSlide />
    <ThanksSlide />
  </main>

  <DeckNav />
</Layout>

<script>
  import { initDeck } from "../lib/deck.ts";
  import { initEffects } from "../lib/effects.ts";
  import { initReveals } from "../lib/motion.ts";

  const cleanups = [initDeck(), initReveals(), initEffects()];

  if (import.meta.hot) {
    import.meta.hot.dispose(() => cleanups.forEach((cleanup) => cleanup()));
  }
</script>
