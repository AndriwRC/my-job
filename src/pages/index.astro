---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <main id="deck" class="mx-auto w-full max-w-4xl px-4 sm:px-6">
    <section
      data-slide
      id="slide-1"
      aria-labelledby="slide-1-heading"
      class="flex min-h-screen flex-col justify-center py-16"
    >
      <div data-reveal>
        <div class="badge badge-primary badge-lg mb-4">My Job &bull; Live Demo</div>
        <h1 id="slide-1-heading" tabindex="-1" class="text-4xl font-bold tracking-tight sm:text-5xl">
          I build interactive experiences for the web.
        </h1>
        <p class="mt-4 max-w-2xl text-lg opacity-80">
          This page <em>is</em> the proof: Astro ships the content, Tailwind + daisyUI theme it,
          and GSAP moves it like slides.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="#slide-2" class="btn btn-primary" data-next>See the stack</a>
          <a href="https://docs.astro.build" class="btn btn-ghost">Astro docs</a>
        </div>
      </div>
    </section>

    <section
      data-slide
      id="slide-2"
      aria-labelledby="slide-2-heading"
      class="flex min-h-screen flex-col justify-center py-16"
    >
      <div data-reveal>
        <div class="badge badge-secondary mb-4">Styling &bull; Tailwind + daisyUI defaults</div>
        <h2 id="slide-2-heading" tabindex="-1" class="text-3xl font-bold sm:text-4xl">
          Themed out of the box.
        </h2>
        <p class="mt-3 max-w-2xl opacity-80">
          No custom theme in this change — these are default daisyUI primitives.
        </p>
      </div>
      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        <div class="card bg-base-200 shadow-xl" data-reveal data-reveal-delay="0.05">
          <div class="card-body">
            <h3 class="card-title">Card + buttons</h3>
            <p class="opacity-80">Utilities and components compose without extra CSS.</p>
            <div class="card-actions mt-2">
              <button type="button" class="btn btn-primary btn-sm">Primary</button>
              <button type="button" class="btn btn-outline btn-sm">Outline</button>
            </div>
          </div>
        </div>
        <div class="card bg-base-200 shadow-xl" data-reveal data-reveal-delay="0.15">
          <div class="card-body">
            <h3 class="card-title">Badges + alert</h3>
            <div class="flex flex-wrap gap-2">
              <span class="badge badge-accent">Astro 7</span>
              <span class="badge badge-neutral">Tailwind v4</span>
              <span class="badge badge-ghost">GSAP 3</span>
            </div>
            <div role="alert" class="alert alert-success mt-3 py-2 text-sm">
              <span>Global stylesheet is live on every page.</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section
      data-slide
      id="slide-3"
      aria-labelledby="slide-3-heading"
      class="flex min-h-screen flex-col justify-center py-16"
    >
      <div data-reveal>
        <div class="badge badge-accent mb-4">Motion &bull; GSAP slide transitions</div>
        <h2 id="slide-3-heading" tabindex="-1" class="text-3xl font-bold sm:text-4xl">
          Slides that move with direction.
        </h2>
        <p class="mt-3 max-w-2xl opacity-80">
          Forward enters from the right, backward from the left. Scroll or use the controls.
        </p>
      </div>
      <ul class="mt-6 space-y-3">
        <li class="card bg-base-200 px-5 py-4 shadow" data-reveal>Fade + rise once per block, never replays on scroll.</li>
        <li class="card bg-base-200 px-5 py-4 shadow" data-reveal data-reveal-delay="0.1">Stagger via <code>data-reveal-delay</code> for guided attention.</li>
        <li class="card bg-base-200 px-5 py-4 shadow" data-reveal data-reveal-delay="0.2">Reduced motion resolves instantly to the final state.</li>
      </ul>
    </section>

    <section
      data-slide
      id="slide-4"
      aria-labelledby="slide-4-heading"
      class="flex min-h-screen flex-col justify-center py-16"
    >
      <div data-reveal>
        <div class="badge badge-ghost mb-4">End &bull; Stack wired</div>
        <h2 id="slide-4-heading" tabindex="-1" class="text-3xl font-bold sm:text-4xl">
          Small and polished beats many halfway.
        </h2>
        <p class="mt-3 max-w-2xl opacity-80">
          Styling and motion now share one shell. Real slide content is the next change.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="#slide-1" class="btn btn-primary" data-prev>Back to start</a>
        </div>
      </div>
    </section>
  </main>

  <nav
    aria-label="Slide navigation"
    class="fixed inset-x-0 bottom-0 z-10 border-t border-base-300 bg-base-100/90 backdrop-blur"
  >
    <div class="mx-auto flex w-full max-w-4xl items-center justify-between gap-3 px-4 py-2 sm:px-6">
      <button type="button" id="deck-prev" class="btn btn-ghost btn-sm">&larr; Prev</button>
      <p class="text-sm opacity-70" aria-live="polite">
        <span id="deck-count">1 / 4</span>
        <span class="hidden sm:inline"> &middot; Arrow keys work too</span>
      </p>
      <button type="button" id="deck-next" class="btn btn-primary btn-sm">Next &rarr;</button>
    </div>
  </nav>
  <div class="h-16" aria-hidden="true"></div>
</Layout>

<script>
  import { initReveals, prefersReducedMotion, transitionSlide } from "../lib/motion.ts";

  const slides = Array.from(document.querySelectorAll("[data-slide]"));
  const count = document.getElementById("deck-count");
  const prevBtn = document.getElementById("deck-prev");
  const nextBtn = document.getElementById("deck-next");
  let currentIndex = 0;
  let navigating = false;

  const cleanupReveals = initReveals(document);

  function updateCount() {
    if (count) count.textContent = `${currentIndex + 1} / ${slides.length}`;
    if (prevBtn) prevBtn.toggleAttribute("disabled", currentIndex === 0);
    if (nextBtn) nextBtn.toggleAttribute("disabled", currentIndex === slides.length - 1);
  }

  function currentClosestIndex() {
    let best = 0;
    let bestDist = Number.POSITIVE_INFINITY;
    const mid = window.innerHeight / 2;
    slides.forEach((slide, i) => {
      const rect = slide.getBoundingClientRect();
      const dist = Math.abs(rect.top + rect.height / 2 - mid);
      if (dist < bestDist) {
        bestDist = dist;
        best = i;
      }
    });
    return best;
  }

  async function goTo(index, direction) {
    if (navigating || index < 0 || index >= slides.length || index === currentIndex) {
      currentIndex = currentClosestIndex();
      updateCount();
      return;
    }
    navigating = true;
    const prev = slides[currentIndex];
    const next = slides[index];
    const dir = direction ?? (index > currentIndex ? "forward" : "backward");
    currentIndex = index;

    if (prefersReducedMotion()) {
      next.scrollIntoView({ behavior: "auto", block: "start" });
    } else {
      next.scrollIntoView({ behavior: "smooth", block: "start" });
      await transitionSlide(prev, next, dir);
    }

    const heading = next.querySelector("h1, h2");
    if (heading instanceof HTMLElement) heading.focus({ preventScroll: true });

    updateCount();
    navigating = false;
  }

  prevBtn?.addEventListener("click", () => void goTo(currentIndex - 1, "backward"));
  nextBtn?.addEventListener("click", () => void goTo(currentIndex + 1, "forward"));

  document.querySelectorAll("a[href^='#slide-']").forEach((link) => {
    link.addEventListener("click", (event) => {
      const id = link.getAttribute("href")?.slice(1);
      const target = id ? document.getElementById(id) : null;
      if (!target) return;
      event.preventDefault();
      const index = slides.indexOf(target);
      void goTo(index);
    });
  });

  window.addEventListener(
    "scroll",
    () => {
      if (!navigating) {
        currentIndex = currentClosestIndex();
        updateCount();
      }
    },
    { passive: true },
  );

  window.addEventListener("keydown", (event) => {
    if (event.key === "ArrowRight" || event.key === "ArrowDown" || event.key === " ") {
      event.preventDefault();
      void goTo(currentIndex + 1, "forward");
    } else if (event.key === "ArrowLeft" || event.key === "ArrowUp") {
      event.preventDefault();
      void goTo(currentIndex - 1, "backward");
    } else if (event.key === "Home") {
      event.preventDefault();
      void goTo(0, "backward");
    } else if (event.key === "End") {
      event.preventDefault();
      void goTo(slides.length - 1, "forward");
    }
  });

  updateCount();

  if (import.meta.hot) {
    import.meta.hot.dispose(() => cleanupReveals());
  }
</script>
