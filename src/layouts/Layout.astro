---
import { Font } from 'astro:assets';
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const {
  description = "Una presentación tipo diapositivas sobre lo que hago como desarrollador web, hecha con Astro, Tailwind, daisyUI y GSAP.",
} = Astro.props;

// Built from a code point so the raw-emoji grep only ever matches <Emoji>.
const laptop = String.fromCodePoint(0x1f4bb);
const title =
  Astro.props.title ?? `Mi trabajo ${laptop} — Presentación de un desarrollador web`;
---
<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
		<Font cssVariable="--font-display" preload />
	</head>
	<body>
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100%;
		overflow-x: clip;
	}
</style>
